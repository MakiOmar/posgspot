APP_NAME="Ultimate POS"
APP_TITLE="Ultimate POS - The Ultimate Point of Sale"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://localhost
APP_LOCALE=en
APP_TIMEZONE=UTC

ADMINISTRATOR_USERNAMES=
ALLOW_REGISTRATION=true

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ultimate_pos
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail — system-wide transport (Laravel default + businesses that enable
# "Use superadmin email settings"). Per-business SMTP stays in Business Settings.
# ---------------------------------------------------------------------------
# Option A: Mailgun API (requires symfony/mailgun-mailer + symfony/http-client)
MAIL_MAILER=mailgun
MAIL_FROM_ADDRESS=noreply@your-verified-domain.com
MAIL_FROM_NAME="${APP_NAME}"
MAILGUN_DOMAIN=your-mailgun-domain
MAILGUN_SECRET=your-mailgun-api-key
# US: api.mailgun.net | EU: api.eu.mailgun.net
MAILGUN_ENDPOINT=api.mailgun.net

# Option B: SMTP — set MAIL_MAILER=smtp and fill these; comment out MAILGUN_* above
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# Smoke test (Mailgun sandbox: authorize the recipient first):
# php artisan tinker
# >>> Mail::raw('Mailgun OK', fn ($m) => $m->to('you@example.com')->subject('Test'));

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

ENVATO_PURCHASE_CODE=
MAC_LICENCE_CODE=

BACKUP_DISK=local
DROPBOX_ACCESS_TOKEN=

STRIPE_PUB_KEY=
STRIPE_SECRET_KEY=

PAYPAL_CLIENT_ID=
PAYPAL_APP_SECRET=
PAYPAL_MODE=sandbox

PAYPAL_SANDBOX_API_USERNAME=
PAYPAL_SANDBOX_API_PASSWORD=
PAYPAL_SANDBOX_API_SECRET=

PAYPAL_LIVE_API_USERNAME=
PAYPAL_LIVE_API_PASSWORD=
PAYPAL_LIVE_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_CURRENCY=USD
PESAPAL_LIVE=false
GOOGLE_MAP_API_KEY=

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PAYMENT_URL=https://api.paystack.co
MERCHANT_EMAIL=

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

ENABLE_GST_REPORT_INDIA=false

OPENAI_API_KEY=
OPENAI_ORGANIZATION=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

MY_FATOORAH_API_KEY=
MY_FATOORAH_IS_TEST=true
MY_FATOORAH_COUNTRY_ISO=KWT

ENABLE_RECAPTCHA=false
GOOGLE_RECAPTCHA_KEY=
GOOGLE_RECAPTCHA_SECRET=

# Storefront public site URL (password-reset links, etc.)
STOREFRONT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=
