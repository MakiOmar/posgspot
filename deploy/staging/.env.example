# Compose-level secrets (copy to /opt/spot-staging/.env on the VPS, chmod 600)
MYSQL_ROOT_PASSWORD=change-me-root-strong
MYSQL_APP_PASSWORD=change-me-app-strong
# POS schema used by configure-production-env.sh and import-db.sh (pos_stg was retired on 2026-10-30)
POS_DB_NAME=pos_live

# Public hosts routed by Traefik
SHOP_DOMAIN=gamesspoteg.com
POS_DOMAIN=pos.gamesspoteg.com
ACCOUNTS_DOMAIN=accounts.gamesspoteg.com

# Cloudflare API token (Zone:DNS:Edit + Zone:Zone:Read on the shop zone) for Let's Encrypt DNS-01
CF_DNS_API_TOKEN=
