# Laravel Storefront API origin (no trailing slash)
EXPO_PUBLIC_API_BASE=http://localhost:8000

# Optional web shop origin for Universal Links / password reset
EXPO_PUBLIC_STOREFRONT_URL=http://localhost:5173

# Social login (public client IDs only — never put client secrets in the app)
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_FACEBOOK_APP_ID=
