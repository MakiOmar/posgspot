{
  "expo": {
    "name": "Games Spot",
    "slug": "gamesspoteg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gamesspot",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gamesspoteg.storefront",
      "deploymentTarget": "16.6",
      "associatedDomains": [
        "applinks:shop.gamesspoteg.com",
        "applinks:new.gamesspoteg.com",
        "applinks:shop.gamesspoteg.com",
        "applinks:new.gamesspoteg.com"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
        "CFBundleDisplayName": "Games Spot",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gamesspoteg.storefront",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "shop.gamesspoteg.com",
              "pathPrefix": "/en/products"
            },
            {
              "scheme": "https",
              "host": "shop.gamesspoteg.com",
              "pathPrefix": "/ar/products"
            },
            {
              "scheme": "https",
              "host": "shop.gamesspoteg.com",
              "pathPrefix": "/en/account/orders"
            },
            {
              "scheme": "https",
              "host": "new.gamesspoteg.com",
              "pathPrefix": "/en/reset-password"
            },
            {
              "scheme": "https",
              "host": "new.gamesspoteg.com",
              "pathPrefix": "/ar/reset-password"
            },
            {
              "scheme": "https",
              "host": "shop.gamesspoteg.com",
              "pathPrefix": "/en/reset-password"
            },
            {
              "scheme": "https",
              "host": "shop.gamesspoteg.com",
              "pathPrefix": "/ar/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF7A00"
        }
      ],
      [
        "expo-dev-client",
        {
          "android": {
            "skipOnboarding": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "imageWidth": 180
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "reactNativeArchitectures": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-image",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Games Spot to use Face ID to unlock your account."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "1ebe2d25-4e07-4fe9-9e8f-b21fd0c8041e"
      },
      "router": {}
    },
    "owner": "itqandeveg"
  }
}
