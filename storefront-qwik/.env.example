# Storefront Qwik — environment variables
# Copy to `.env.ssr` (dev) or `.env.production` (build). Public vars must use
# the PUBLIC_ prefix to be exposed to the browser (see vite.config.ts).

# Laravel Storefront API base URL (no trailing slash)
PUBLIC_API_BASE=http://localhost:8000

# Header layout: `one` (single row) or `two` (main row + nav/categories row). Default: two
PUBLIC_HEADER_STYLE=two

# Arabic UI font provider: `google` (default) or `self-hosted` (loads `/fonts/cairo.css`)
# PUBLIC_ARABIC_FONT_PROVIDER=google

# Optional POS web origin for remaining external POS links (defaults to PUBLIC_API_BASE)
# PUBLIC_POS_WEB_BASE=http://localhost:8000

# CSP: optional extra connect-src origins (space-separated). Report-only mode for staging.
# PUBLIC_CSP_EXTRA_CONNECT_SRC=
# PUBLIC_CSP_REPORT_ONLY=false
