# Production env (mode "production"). Loaded by `npm run build` and
# `npm run preview` (which runs a production build). Public vars must be
# prefixed with PUBLIC_ to be exposed to the browser.
#
# Preview SSR fetches this host from Node. If you see ConnectTimeoutError /
# "settings loader failed", either the host is unreachable from your machine
# or point this at local Laravel for offline preview:
#   PUBLIC_API_BASE=http://localhost:8000

PUBLIC_API_BASE=https://posstaging.gamesspoteg.com

# Header layout: one | two (default: two)
PUBLIC_HEADER_STYLE=two
