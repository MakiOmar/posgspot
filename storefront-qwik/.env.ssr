# Dev-only env (mode "ssr"). The `npm run dev` / `npm start` scripts run
# `vite --mode ssr`, so Vite loads this file and it overrides .env.
# Point local Qwik at the live POS Storefront API.

PUBLIC_API_BASE=https://pos.gamesspoteg.com

# Header layout: one | two (default: two)
PUBLIC_HEADER_STYLE=two
